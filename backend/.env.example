MONGODB_URI=mongodb://127.0.0.1:27017/tradelab

PORT=5000
NODE_ENV=development

CLIENT_URL=http://localhost:5173
API_URL=http://localhost:5000

JWT_SECRET=replace_with_your_own_long_secret
JWT_EXPIRES_IN=7d
AUTH_COOKIE_NAME=tradelab_token

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_google_app_password
MAIL_FROM="TradeLab <your_email@gmail.com>"

# Market data (Finnhub.io) — get a free key at https://finnhub.io/dashboard
FINNHUB_API_KEY=your_finnhub_api_key
# Optional: how often the server auto-refreshes prices in the background (ms).
# 0 disables the loop. Finnhub free tier allows ~60 requests/minute.
FINNHUB_REFRESH_INTERVAL_MS=0
# Optional: delay between per-symbol calls during a refresh (ms).
FINNHUB_REFRESH_DELAY_MS=0