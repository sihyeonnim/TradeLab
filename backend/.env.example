MONGODB_URI=mongodb://127.0.0.1:27017/tradelab

PORT=5000
NODE_ENV=development

CLIENT_URL=http://localhost:5173
API_URL=http://localhost:5000

JWT_SECRET=replace_with_your_own_long_secret
JWT_EXPIRES_IN=7d
AUTH_COOKIE_NAME=tradelab_token

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_google_app_password
MAIL_FROM="TradeLab <your_email@gmail.com>"
ALPHA_VANTAGE_API_KEY=AaAa12341234  #replace_with_your_alpha_vantage_api_key

# Local simulator updates virtual prices without using external API.
AUTO_MARKET_SIMULATOR_ENABLED=true
AUTO_MARKET_TICK_SECONDS=1

# Real Alpha Vantage refresh is automatic and limited to avoid free API quota issues.
# Default schedule in Korea time: 21:00, 00:00, 03:00, 06:00 = 4 full refreshes/day.
# With 5 assets, this is 20 API requests/day.
AUTO_REAL_MARKET_REFRESH_ENABLED=true
AUTO_REAL_MARKET_REFRESH_TIMEZONE=Asia/Seoul
AUTO_REAL_MARKET_REFRESH_HOURS=21,0,3,6
AUTO_REAL_MARKET_REFRESH_CHECK_SECONDS=60
